# ─── Database (Turso / libSQL) ───────────────────────────────────────────────
# Create a database at https://turso.tech and copy the URL + auth token.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── Pexels (stock imagery & video) ──────────────────────────────────────────
# Free API key from https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key

# ─── Auth (JWT session signing) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-byte-random-secret

# ─── Vercel Blob (image/video uploads) ───────────────────────────────────────
# From the Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
