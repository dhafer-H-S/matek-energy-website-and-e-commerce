# ─── Database (Turso / libSQL) ───────────────────────────────────────────────
# Create a database at https://turso.tech and copy the URL + auth token.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ─── Pexels (stock imagery & video) ──────────────────────────────────────────
# Free API key from https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key

# ─── Auth (JWT session signing) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-byte-random-secret

# ─── Vercel Blob (image/video uploads) ───────────────────────────────────────
# From the Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email notifications: Gmail SMTP via Nodemailer (server-only) ────────────
# Use a Gmail account with 2-Step Verification enabled, then create a
# 16-character App Password at https://myaccount.google.com/apppasswords.
# Never use the normal account password, and never prefix with NEXT_PUBLIC_.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
# Optional display name shown as the email sender (defaults to "Matek Energy").
MAIL_FROM_NAME=Matek Energy
